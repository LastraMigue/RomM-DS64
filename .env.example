# ==========================================
# Configuración de Base de Datos (MariaDB)
# ==========================================
DB_ROOT_PASSWORD=cambia_esta_contrasena_root
DB_USER=romm
DB_PASSWORD=cambia_esta_contrasena_usuario
DB_NAME=romm

# ==========================================
# Seguridad de RomM
# ==========================================
# Genera un string aleatorio largo (ej. openssl rand -hex 32)
ROMM_AUTH_SECRET_KEY=cambia_esta_clave_por_una_cadena_larga_y_aleatoria

# ==========================================
# Metadatos IGDB / Twitch Developer
# ==========================================
# Obtén tus credenciales en: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=tu_client_id_de_twitch
IGDB_CLIENT_SECRET=tu_client_secret_de_twitch

